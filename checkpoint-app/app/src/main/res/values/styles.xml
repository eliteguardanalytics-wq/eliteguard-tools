<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Everything lives on the Base theme so values-v35 can add one attribute without
        restating the rest. A style declared in a more specific resource folder replaces the
        base one outright rather than merging with it.
    -->
    <style name="Theme.EliteGuard" parent="Theme.EliteGuard.Base" />

    <style name="Theme.EliteGuard.Base" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">@color/ink</item>
        <item name="android:colorPrimaryDark">@color/ink_deep</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:statusBarColor">@color/ink_deep</item>
        <item name="android:navigationBarColor">@color/ink_deep</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:alertDialogTheme">@style/Theme.EliteGuard.Dialog</item>
    </style>

    <style name="Theme.EliteGuard.Dialog" parent="android:Theme.Material.Light.Dialog.Alert">
        <item name="android:colorAccent">@color/ink</item>
    </style>

    <!--
        Height is wrap_content with a 56dp floor rather than a fixed 56dp, because the status
        bar inset is added to this view as top padding. A fixed height would keep the bar the
        same size and push its own title out of it.
    -->
    <style name="Toolbar">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:background">@color/ink</item>
        <item name="android:theme">@style/ToolbarTheme</item>
        <item name="android:elevation">4dp</item>
    </style>

    <style name="ToolbarTheme" parent="android:ThemeOverlay.Material.Dark.ActionBar">
        <item name="android:textColorPrimary">@color/on_ink</item>
        <item name="android:textColorSecondary">@color/on_ink_muted</item>
    </style>

    <style name="Input">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:padding">14dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_secondary</item>
    </style>

    <style name="PrimaryButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:background">@drawable/bg_button_primary</item>
        <item name="android:textColor">@color/on_ink</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="SecondaryButton" parent="PrimaryButton">
        <item name="android:background">@drawable/bg_button_secondary</item>
        <item name="android:textColor">@color/ink</item>
    </style>

    <style name="DangerButton" parent="PrimaryButton">
        <item name="android:background">@drawable/bg_button_danger</item>
    </style>

    <style name="Card">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:padding">16dp</item>
    </style>

    <!-- Marks a tile that is on the screen but not built yet. -->
    <style name="ComingSoon">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_badge</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:paddingBottom">4dp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Label">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
