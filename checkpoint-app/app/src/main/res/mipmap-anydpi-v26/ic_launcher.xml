<?xml version="1.0" encoding="utf-8"?>
<!--
    The Siloam One emblem on a Bone tile. The rings inside the emblem are transparent rather
    than white, so the tile colour shows through them: on Ink the slate would nearly vanish,
    which is why the background is light.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
